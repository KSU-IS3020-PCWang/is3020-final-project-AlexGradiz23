"""
Property Registry System
Author: Alexandra N Gradiz
Course: IS 3020

Description:
A console-based property management application that allows consumers,
businesses, and government representatives to view, purchase, lease, or consult
on available properties. Persistence is maintained via a local CSV file.
"""

import csv
import os

# File configuration
DATA_FILE = "registry_data.csv"

# Headers used for the CSV file structure
CSV_HEADERS = ["Category", "AvailableUnits", "UnitPrice", "LeaseRate", "ContactNumber"]

# Default dataset used if the CSV file does not exist
DEFAULT_INVENTORY = {
    "Residential": {
        "available_units": 5,
        "price_per_unit": 250000.0,
        "lease_rate": 0.0,
        "contact_number": "N/A"
    },
    "Business": {
        "available_units": 3,
        "price_per_unit": 500000.0,
        "lease_rate": 4500.0,
        "contact_number": "N/A"
    },
    "Administrative": {
        "available_units": 10,
        "price_per_unit": 0.0,
        "lease_rate": 0.0,
        "contact_number": "555-555"
    }
}


def load_data(filename):
    """
    Loads property registry data from CSV file into a dictionary structure.
    Creates new CSV file with default data if one not found.
    """
    if not os.path.exists(filename):
        print("CSV file not found. Initializing new registry database...")
        save_data(filename, DEFAULT_INVENTORY)
        return DEFAULT_INVENTORY

    inventory = {}
    try:
        with open(filename, mode="r", newline="", encoding="utf-8") as file:
            reader = csv.DictReader(file)
            for row in reader:
                category = row["Category"]
                inventory[category] = {
                    "available_units": int(row["AvailableUnits"]),
                    "price_per_unit": float(row["UnitPrice"]),
                    "lease_rate": float(row["LeaseRate"]),
                    "contact_number": row["ContactNumber"]
                }
        return inventory
    except (IOError, ValueError, KeyError) as e:
        print(f"Error loading CSV file ({e}). Reverting to default configuration.")
        return DEFAULT_INVENTORY


def save_data(filename, inventory):
    """
    Saves the current state of the property registry back to CSV file.
    """
    try:
        with open(filename, mode="w", newline="", encoding="utf-8") as file:
            writer = csv.writer(file)
            # Write header row
            writer.writerow(CSV_HEADERS)

            # Write data rows
            for category, data in inventory.items():
                writer.writerow([
                    category,
                    data["available_units"],
                    data["price_per_unit"],
                    data["lease_rate"],
                    data["contact_number"]
                ])
        print("Data successfully saved to CSV.")
    except IOError as e:
        print(f"Failed to save data to CSV file: {e}")


def display_inventory(inventory):
    """
    Prints an overview of all property categories and availability.
    """
    print("\n" + "=" * 45)
    print("        CURRENT PROPERTY REGISTRY")
    print("=" * 45)

    res = inventory["Residential"]
    print(f"1. Residential Properties")
    print(f"   - Stock Available: {res['available_units']} units")
    print(f"   - Unit Price: ${res['price_per_unit']:,.2f}")

    biz = inventory["Business"]
    print(f"\n2. Business Properties")
    print(f"   - Stock Available: {biz['available_units']} units")
    print(f"   - Purchase Price: ${biz['price_per_unit']:,.2f}")
    print(f"   - Lease Rate: ${biz['lease_rate']:,.2f} / month")

    admin = inventory["Administrative"]
    print(f"\n3. Administrative Properties")
    print(f"   - Consultation Contact: {admin['contact_number']}")
    print("=" * 45 + "\n")


def process_residential(inventory, purchased_types):
    """
    Handles residential property purchases while enforcing consumer protection rules
    (blocking access if user has already bought >= 2 distinct property types).
    """
    # Consumer Protection Check: limit total property types acquired to under 2
    if len(purchased_types) >= 2:
        print("\n[ERROR] Consumer Protection Limit Reached!")
        print("You have already engaged with 2 or more property types.")
        print("To protect regular consumers, additional acquisitions are blocked.")
        return

    res_data = inventory["Residential"]
    if res_data["available_units"] <= 0:
        print("\nSorry, no residential units are currently available.")
        return

    print("\n--- Residential Property Procurement ---")
    print(f"Available Units: {res_data['available_units']}")
    print(f"Price per Unit: ${res_data['price_per_unit']:,.2f}")

    try:
        quantity = int(input("How many units would you like to purchase? "))

        if quantity <= 0:
            print("Quantity must be greater than zero.")
            return

        if quantity > res_data["available_units"]:
            print(f"Transaction declined. Only {res_data['available_units']} units available.")
            return

        total_cost = quantity * res_data["price_per_unit"]

        # Confirm transaction
        confirm = input(f"Total cost is ${total_cost:,.2f}. Confirm purchase? (y/n): ").strip().lower()
        if confirm == 'y':
            res_data["available_units"] -= quantity
            purchased_types.add("Residential")
            print(f"\nPurchase Successful! Total Charged: ${total_cost:,.2f}")
            print(f"Remaining Residential Units: {res_data['available_units']}")
        else:
            print("Transaction canceled.")

    except ValueError:
        print("Invalid entry. Please enter a whole number for quantity.")


def process_business(inventory, purchased_types):
    """
    Handles commercial property procurement, gathering income specifics and
    calculating purchase or lease totals.
    """
    biz_data = inventory["Business"]
    if biz_data["available_units"] <= 0:
        print("\nSorry, no business units are currently available.")
        return

    print("\n--- Business Property Procurement ---")
    biz_name = input("Enter your Business Name: ").strip()

    try:
        expected_income = float(input("Enter Expected Annual Income ($): "))
        if expected_income < 0:
            print("Income cannot be negative.")
            return
    except ValueError:
        print("Invalid entry. Please enter a valid numerical value for income.")
        return

    print("\nOptions:")
    print("1. Buy Property outright")
    print("2. Lease Property (6 Months)")
    print("3. Lease Property (12 Months)")

    choice = input("Select an option (1-3): ").strip()

    if choice == "1":
        total = biz_data["price_per_unit"]
        terms = "Outright Purchase"
    elif choice == "2":
        total = biz_data["lease_rate"] * 6
        terms = "6-Month Lease"
    elif choice == "3":
        total = biz_data["lease_rate"] * 12
        terms = "12-Month Lease"
    else:
        print("Invalid option selected.")
        return

    print("\n" + "-" * 30)
    print(f"Business: {biz_name}")
    print(f"Expected Income: ${expected_income:,.2f}")
    print(f"Selected Terms: {terms}")
    print(f"Total Amount Due: ${total:,.2f}")
    print("-" * 30)

    confirm = input("Confirm transaction? (y/n): ").strip().lower()
    if confirm == 'y':
        biz_data["available_units"] -= 1
        purchased_types.add("Business")
        print("\nTransaction Complete! Business unit successfully reserved.")
    else:
        print("Transaction canceled.")


def process_administrative(inventory):
    """
    Routes government and state representatives to consultation contacts.
    """
    print("\n--- Administrative Property Consultation Routing ---")
    org = input("Enter your Organization Name (e.g., City of X, State Dept): ").strip()
    rep_title = input("Enter your Official Title: ").strip()

    if not org or not rep_title:
        print("Organization and Title are required for administrative routing.")
        return

    contact = inventory["Administrative"]["contact_number"]

    print("\n" + "*" * 50)
    print(f"OFFICIAL ROUTING RECEIPT")
    print(f"Representative: {rep_title}")
    print(f"Organization: {org}")
    print(f"Direct Consultation Contact Line: {contact}")
    print("Please call this line to finalize municipal property transfers.")
    print("*" * 50)


def main():
    """
    Main application entry point and interactive loop control.
    """
    # Load state from CSV file
    inventory = load_data(DATA_FILE)

    # Track property categories accessed by the user
    purchased_types = set()

    print("===============================================")
    print("  WELCOME TO THE MUNICIPAL PROPERTY REGISTRY   ")
    print("===============================================")

    while True:
        print("\n--- MAIN MENU ---")
        print("1. View Property Registry Availability")
        print("2. Purchase Residential Property")
        print("3. Procure Business Property (Buy/Lease)")
        print("4. Administrative Direct Consultation")
        print("5. Save and Exit")

        user_choice = input("Enter choice (1-5): ").strip()

        if user_choice == "1":
            display_inventory(inventory)
        elif user_choice == "2":
            process_residential(inventory, purchased_types)
        elif user_choice == "3":
            process_business(inventory, purchased_types)
        elif user_choice == "4":
            process_administrative(inventory)
        elif user_choice == "5":
            save_data(DATA_FILE, inventory)
            print("Thank you for using the Property Registry system. Goodbye!")
            break
        else:
            print("Invalid menu selection. Please enter a number between 1 and 5.")


if __name__ == "__main__":
    main()
